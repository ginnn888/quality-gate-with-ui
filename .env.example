# Copy to .env.local.

# ─── GitHub sign-in (REQUIRED) ────────────────────────────────────────────────
# The console has no anonymous mode: every user signs in through GitHub OAuth,
# and repository reads are performed with that user's own token.
#
# Create the app at  https://github.com/settings/developers  → "New OAuth App"
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Any long random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# ─── Analysis engine ──────────────────────────────────────────────────────────
# "simulation" (default) or "live"
QG_ENGINE=simulation

# Google Gemini API key — enables real AI review + test generation
GEMINI_API_KEY=

# SonarCloud — enables a REAL sonar-scanner upload + Quality Gate poll.
# Needs `npm i sonarqube-scanner` (already a dependency) and a token with
# "Execute Analysis" permission on the project.
SONAR_TOKEN=
SONAR_PROJECT_KEY=
SONAR_ORGANIZATION=
# Web runs scan into this branch so the project's main analysis is untouched.
# Empty = scan main directly.
QG_SONAR_BRANCH=qg-console
QG_SONAR_MAX_ATTEMPTS=24

# Path to a Node project used as the audit target for `npm audit`
# Defaults to the bundled sample project.
QG_AUDIT_PROJECT=
